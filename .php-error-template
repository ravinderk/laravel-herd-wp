/**
 * Custom PHP Error Template for WordPress
 * This file is executed when a fatal PHP error occurs
 * 
 * @see https://github.com/WordPress/wordpress-develop/blob/7cf0bb5594ab336a2c919958378035e4bbf46db4/src/wp-includes/class-wp-fatal-error-handler.php#L147
 */

// Function to detect if running in terminal/CLI environment
function is_terminal_environment() {
    return php_sapi_name() === 'cli' || php_sapi_name() === 'cli-server' || 
           (defined('STDIN') && is_resource(STDIN)) ||
           !isset($_SERVER['HTTP_HOST']);
}

// Function to display terminal-friendly error
function display_terminal_error($error) {
    echo "\n";
    echo "💥 PHP FATAL ERROR\n";
    echo str_repeat("=", 50) . "\n\n";
    
    if ($error && is_array($error)) {
        if (isset($error['message'])) {
            echo "Error Message:\n";
            echo $error['message'] . "\n\n";
        }
        
        if (isset($error['type'])) {
            $errorTypes = [
                E_ERROR => 'Fatal Error',
                E_WARNING => 'Warning',
                E_PARSE => 'Parse Error',
                E_NOTICE => 'Notice',
                E_CORE_ERROR => 'Core Error',
                E_CORE_WARNING => 'Core Warning',
                E_COMPILE_ERROR => 'Compile Error',
                E_COMPILE_WARNING => 'Compile Warning',
                E_USER_ERROR => 'User Error',
                E_USER_WARNING => 'User Warning',
                E_USER_NOTICE => 'User Notice',
                E_STRICT => 'Strict Standards',
                E_RECOVERABLE_ERROR => 'Recoverable Error',
                E_DEPRECATED => 'Deprecated',
                E_USER_DEPRECATED => 'User Deprecated'
            ];
            echo "Error Type:\n";
            echo ($errorTypes[$error['type']] ?? 'Unknown Error') . " (" . $error['type'] . ")\n\n";
        }
        
        if (isset($error['file'])) {
            echo "File:\n";
            echo $error['file'] . "\n\n";
        }
        
        if (isset($error['line'])) {
            echo "Line:\n";
            echo $error['line'] . "\n\n";
        }
    } else {
        echo "No detailed error information available.\n\n";
    }
    
    echo "Timestamp: " . date('Y-m-d H:i:s T') . "\n";
    echo str_repeat("=", 50) . "\n";
    
    // Exit with error code for CLI
    exit(1);
}

// Check if running in terminal and display appropriate error
if (is_terminal_environment()) {
    $error = error_get_last();
    display_terminal_error($error);
}

// Set appropriate HTTP status code for web requests
