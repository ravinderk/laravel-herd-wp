    <script>
        function copyErrorToClipboard() {
            const button = document.querySelector('.copy-button');
            const copyText = button.querySelector('.copy-text');
            const copyIcon = button.querySelector('.copy-icon');
            
            // Generate terminal-like error text
            const errorText = generateTerminalErrorText();
            
            // Copy to clipboard
            navigator.clipboard.writeText(errorText).then(function() {
                // Show success feedback
                button.classList.add('copied');
                copyIcon.textContent = '✅';
                copyText.textContent = 'Copied!';
                
                // Reset after 2 seconds
                setTimeout(function() {
                    button.classList.remove('copied');
                    copyIcon.textContent = '📋';
                    copyText.textContent = 'Copy Error for Debugging';
                }, 2000);
            }).catch(function(err) {
                // Fallback for older browsers
                const textArea = document.createElement('textarea');
                textArea.value = errorText;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                
                // Show success feedback
                button.classList.add('copied');
                copyIcon.textContent = '✅';
                copyText.textContent = 'Copied!';
                
                // Reset after 2 seconds
                setTimeout(function() {
                    button.classList.remove('copied');
                    copyIcon.textContent = '📋';
                    copyText.textContent = 'Copy Error for Debugging';
                }, 2000);
            });
        }
        
        function generateTerminalErrorText() {
            <?php if ($error && is_array($error)): ?>
            let errorText = "💥 PHP FATAL ERROR\n";
            errorText += "=".repeat(50) + "\n\n";
            
            <?php if (isset($error['message'])): ?>
            errorText += "Error Message:\n";
            errorText += <?php echo json_encode($error['message']); ?> + "\n\n";
            <?php endif; ?>
            
            <?php if (isset($error['type'])): ?>
            errorText += "Error Type:\n";
            <?php 
            $errorTypes = [
                E_ERROR => 'Fatal Error',
                E_WARNING => 'Warning', 
                E_PARSE => 'Parse Error',
                E_NOTICE => 'Notice',
                E_CORE_ERROR => 'Core Error',
                E_CORE_WARNING => 'Core Warning',
                E_COMPILE_ERROR => 'Compile Error',
                E_COMPILE_WARNING => 'Compile Warning',
                E_USER_ERROR => 'User Error',
                E_USER_WARNING => 'User Warning',
                E_USER_NOTICE => 'User Notice',
                E_STRICT => 'Strict Standards',
                E_RECOVERABLE_ERROR => 'Recoverable Error',
                E_DEPRECATED => 'Deprecated',
                E_USER_DEPRECATED => 'User Deprecated'
            ];
            $errorTypeName = $errorTypes[$error['type']] ?? 'Unknown Error';
            ?>
            errorText += <?php echo json_encode($errorTypeName . ' (' . $error['type'] . ')'); ?> + "\n\n";
            <?php endif; ?>
            
            <?php if (isset($error['file'])): ?>
            errorText += "File:\n";
            errorText += <?php echo json_encode($error['file']); ?> + "\n\n";
            <?php endif; ?>
            
            <?php if (isset($error['line'])): ?>
            errorText += "Line:\n";
            errorText += <?php echo json_encode((string)$error['line']); ?> + "\n\n";
            <?php endif; ?>
            
            errorText += "Timestamp: " + <?php echo json_encode(date('Y-m-d H:i:s T')); ?> + "\n";
            errorText += "=".repeat(50);
            
            return errorText;
            <?php else: ?>
            return "💥 PHP FATAL ERROR\n" + 
                   "=".repeat(50) + "\n\n" +
                   "No detailed error information available.\n\n" +
                   "Timestamp: " + <?php echo json_encode(date('Y-m-d H:i:s T')); ?> + "\n" +
                   "=".repeat(50);
            <?php endif; ?>
        }
    </script>
